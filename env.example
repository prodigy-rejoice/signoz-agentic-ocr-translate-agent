# Copy this to .env and fill in your values

GROQ_API_KEY=your_groq_api_key_here

# SigNoz OTel Collector endpoint (default for local Foundry/docker self-host)
OTLP_ENDPOINT=http://localhost:4318

OTEL_SERVICE_NAME=ocr-translate-agent

PORT=3000

# Confidence below this triggers the agentic retry (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.7
